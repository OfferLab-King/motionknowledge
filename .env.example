# Public brand (safe to embed in the browser)
NEXT_PUBLIC_PRODUCT_NAME=MotionKnowledge
NEXT_PUBLIC_PRODUCT_DOMAIN=motionknowledge.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@motionknowledge.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
SUPABASE_JWT_SECRET=placeholder-jwt-secret

# Database (local Supabase Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Paid providers are OPTIONAL. The bundled DCF workflow runs credential-free
# with deterministic local/mock providers.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OpenAI-compatible endpoint. The OpenCode Go (Zen) API works with the token
# opencode stores at ~/.local/share/opencode/auth.json under "opencode-go".
# Fill LLM_API_KEY with that token (or any compatible endpoint's key).
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
TTS_PROVIDER=mock
TTS_VOICE=en-US-Neural2-F
TTS_SAMPLE_RATE=24000
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_MODEL=eleven_multilingual_v2
GOOGLE_TTS_CREDENTIALS_JSON=
ELEVENLABS_API_KEY=
HYPERFRAMES_RENDER_IMAGE=motionknowledge-hyperframes:0.7.107
RUN_HYPERFRAMES_SMOKE=0

# Storage: local is the default; S3-compatible (Supabase Storage) when set
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Rendering
PREVIEW_WIDTH=640
PREVIEW_HEIGHT=360
RENDER_WIDTH=1280
RENDER_HEIGHT=720

# Operational
PORT=3000
WORKER_POLL_INTERVAL_MS=1000
LOG_LEVEL=info
