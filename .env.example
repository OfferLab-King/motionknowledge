# Public brand (safe to embed in the browser)
NEXT_PUBLIC_PRODUCT_NAME=MotionKnowledge
NEXT_PUBLIC_PRODUCT_DOMAIN=motionknowledge.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@motionknowledge.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
SUPABASE_JWT_SECRET=placeholder-jwt-secret

# Database (local Supabase Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Paid providers are OPTIONAL. The bundled DCF workflow runs credential-free
# with deterministic local/mock providers.
OPENAI_API_KEY=
GOOGLE_TTS_CREDENTIALS_JSON=
ELEVENLABS_API_KEY=
HYPERFRAMES_RENDER_IMAGE=motionknowledge-hyperframes:0.7.107
RUN_HYPERFRAMES_SMOKE=0

# Storage: local is the default; S3-compatible (Supabase Storage) when set
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Operational
PORT=3000
WORKER_POLL_INTERVAL_MS=1000
LOG_LEVEL=info
