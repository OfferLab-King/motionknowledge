              "year": 1,
              "label": "Year 1",
              "amount": 30,
              "displayAmount": "$30",
              "type": "inflow"
            },
            {
              "year": 2,
              "label": "Year 2",
              "amount": 40,
              "displayAmount": "$40",
              "type": "inflow"
            },
            {
              "year": 3,
              "label": "Year 3",
              "amount": 50,
              "displayAmount": "$50",
              "type": "inflow"
            }
          ]
        }
      },
      "provider": {
