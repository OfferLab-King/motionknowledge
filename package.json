{
  "name": "motionknowledge",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dcf:generate": "tsx scripts/generate-dcf.ts",
    "dcf:preview": "tsx scripts/preview-dcf.ts",
    "dcf:render": "tsx scripts/render-dcf.ts",
    "verify:release": "pnpm verify && pnpm --filter @motionknowledge/remotion-engine test:matrix"
  },
  "devDependencies": {
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "tsx": "4.20.6"
  }
}
